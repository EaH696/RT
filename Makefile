.PHONY: test test-py test-go build fmt

test: test-py test-go

test-py:
	cd orchestrator && python -m pytest -q

test-go:
	cd policy-gate && go test ./...
	cd sandbox && go test ./...

build:
	cd policy-gate && go build -o ../bin/rt-policy-gate ./...
	cd sandbox && go build -o ../bin/rt-sandbox ./...
	cd orchestrator && pip install -e . >/dev/null

fmt:
	cd policy-gate && go fmt ./...
	cd sandbox && go fmt ./...
